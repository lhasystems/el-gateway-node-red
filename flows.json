                "fn0003rowstoseries"
            ]
        ]
    },
    {
        "id": "fn0003rowstoseries",
        "type": "function",
        "z": "87ffda68aee91435",
        "name": "rows -> chart series",
        "func": "var rows = msg.payload || [];\n\nfunction series(key) {\n    return rows.map(function (r) {\n        return { x: r.ts, y: r[key] };\n    });\n}\n\nvar temps = [\n    { topic: 'setpoint', payload: series('setpoint'), action: 'replace' },\n    { topic: 'room', payload: series('room') }\n];\nvar pct = [\n    { topic: 'motor', payload: series('motor'), action: 'replace' },\n    { topic: 'heater', payload: series('heater') }\n];\n\nreturn [temps, pct];",
        "outputs": 2,
