            ]
        ]
    },
    {
        "id": "sq0004queryhistory",
        "type": "sqlite",
        "z": "87ffda68aee91435",
        "mydb": "36b8a4cdf7d7347c",
        "sqlquery": "prepared",
        "sql": "SELECT ts, setpoint, room, motor, heater FROM display WHERE gidx = $gidx AND ts >= $since ORDER BY ts ASC",
        "name": "query display history",
        "x": 900,
        "y": 860,
        "wires": [
