    {
        "id": "fn0002historyparams",
        "type": "function",
        "z": "87ffda68aee91435",
        "name": "build history query params",
        "func": "var gidx = global.get('selectedGidx');\nif (gidx === undefined || gidx === null) { gidx = 0; }\n\nmsg.params = {\n    \"$gidx\": gidx,\n    \"$since\": Date.now() - (30 * 60 * 1000)\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 860,
